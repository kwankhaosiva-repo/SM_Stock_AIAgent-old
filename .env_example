# ==== LLM Providers (ใส่เท่าที่มี — ไม่มี key = ข้าม provider นั้น) ====
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_NAME=meta/llama-3.1-8b-instruct
OPENROUTER_API_KEY=   # (หรือ OPENROUTER_API)
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434   # local dev only
OLLAMA_MODEL_NAME=mistral-small3.2:24b
# ลำดับ failover: ส่ง prompt+context เดิมให้ตัวถัดไปเมื่อตัวหน้าล่ม/โดน 429
LLM_PROVIDER_ORDER=gemini,groq,cerebras,mistral,cloudflare,ollama

# ==== Market data ====
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
# Settrade Open API (official Thai feed — สมัครฟรีที่ developer.settrade.com)
# ไม่ใส่ = ข้ามไปใช้ yfinance/relay ตาม chain
# หมายเหตุ: ตั้งแต่ 16 ก.ย. 2026 Sandbox เข้าถึงได้จาก IP ในไทยเท่านั้น
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=098
SETTRADE_APP_CODE=SANDBOX
SETTRADE_IS_SANDBOX=true
# credentials สำหรับ login (จำเป็นตอนเปิดใช้จริง/production)
SETTRADE_USERNAME=
SETTRADE_PASSWORD=
PIN=
Equity_Account=
Derivatives_Account=
# Financial Modeling Prep (งบดุล fallback เมื่อ Yahoo โดนบล็อก)
FMP_API_KEY=
# Local data relay (Cloudflare Tunnel URL จากเครื่องบ้าน — ดู src/data_relay_agent.py)
DATA_RELAY_URL=
DATA_RELAY_TOKEN=

# ==== Database (ปล่อยว่าง = SQLite local) ====
DATABASE_URL=
REDIS_URL=

# ==== LINE API ====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
WEBHOOK_URL=

# ==== Discord Bot (optional — รันแยก: python src/discord_bot.py) ====
DISCORD_BOT_TOKEN=

# ==== Database (Postgres — ปล่อยว่าง = SQLite local) ====
POSTGRES_URL=


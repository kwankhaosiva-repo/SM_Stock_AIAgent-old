# ==== LLM Providers (ใส่เท่าที่มี — ไม่มี key = ข้าม provider นั้น) ====
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_NAME=meta/llama-3.1-8b-instruct
OLLAMA_BASE_URL=
OLLAMA_MODEL_NAME=llama3.1
# ลำดับ failover: ส่ง prompt+context เดิมให้ตัวถัดไปเมื่อตัวหน้าล่ม/โดน 429
LLM_PROVIDER_ORDER=gemini,groq,cerebras,mistral,cloudflare,ollama

